    "typescript": "^7.0.2"
  },
  "dependencies": {
    "ws": "^8.22.0"
  },
  "private": true,
  "author": "n0ctx",
  "repository": {
    "type": "git",
    "url": "https://github.com/n0ctx/obsidian-meeting-live.git"
